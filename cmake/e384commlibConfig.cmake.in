@PACKAGE_INIT@

cmake_path(SET FTDI_UTILS_PATH_CMAKE "$ENV{FTDI_UTILS_PATH}")
list(APPEND CMAKE_PREFIX_PATH "${FTDI_UTILS_PATH_CMAKE}")
cmake_path(SET FRONT_PANEL_PATH_CMAKE "$ENV{FRONT_PANEL_PATH}")
list(APPEND CMAKE_MODULE_PATH "${FRONT_PANEL_PATH_CMAKE}cmake")
cmake_path(SET CY_API_PATH_CMAKE "$ENV{CY_API_PATH}")
list(APPEND CMAKE_MODULE_PATH "${CY_API_PATH_CMAKE}cmake")
cmake_path(SET TOML_PP_PATH_CMAKE "$ENV{TOML_PP_PATH}")
list(APPEND CMAKE_MODULE_PATH "${TOML_PP_PATH_CMAKE}cmake")
include(CMakeFindDependencyMacro)

find_dependency(ftdi_utils 1.6 CONFIG)
find_dependency(FrontPanel)
find_dependency(CyAPI)
find_dependency(tomlpp)

# A single targets file for all configurations (Debug/Release/...): CMake loads
# e384commlibTargets-debug.cmake, -release.cmake and picks the right library,
# also with multi-config generators (Visual Studio, Ninja Multi-Config)
include("${CMAKE_CURRENT_LIST_DIR}/e384commlibTargets.cmake")

# RelWithDebInfo / MinSizeRel use the release runtime (/MD): link the Release library
if(TARGET e384commlib::e384commlib)
    set(_e384commlib_target e384commlib::e384commlib)
elseif(TARGET e384commlib::e384commlib_labview)
    set(_e384commlib_target e384commlib::e384commlib_labview)
endif()
if(DEFINED _e384commlib_target)
    set_target_properties(${_e384commlib_target} PROPERTIES
        MAP_IMPORTED_CONFIG_RELWITHDEBINFO "Release"
        MAP_IMPORTED_CONFIG_MINSIZEREL "Release"
    )
    unset(_e384commlib_target)
endif()

check_required_components(e384commlib)
